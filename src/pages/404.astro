---
import Base from '@/layouts/Base.astro';
import { withBase } from '@/lib/utils';
---

<Base title="Страница не найдена">
  <main id="main" class="mx-auto flex min-h-dvh max-w-xl flex-col justify-center px-6">
    <p class="text-sm text-muted">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Такой страницы нет</h1>
    <p class="mt-3 text-muted">Возможно, кейс переехал или в ссылке опечатка. Все кейсы — на главной.</p>
    <a href={withBase('/#cases')} class="mt-6 self-start rounded-full bg-accent px-5 py-2.5 font-medium text-on-accent">К кейсам</a>
  </main>
</Base>
