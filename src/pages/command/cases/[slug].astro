---
// Старые адреса концепта /command/cases/<slug> ведут на /cases/<slug>
import { getCollection } from 'astro:content';
import { withBase } from '@/lib/utils';

export async function getStaticPaths() {
  const cases = await getCollection('cases', ({ data }) => !data.draft);
  return cases.map((entry) => ({ params: { slug: entry.id } }));
}
const to = withBase(`/cases/${Astro.params.slug}`);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <link rel="canonical" href={to} />
    <meta name="robots" content="noindex" />
    <title>Кейс — портфолио Евгения Горлинского</title>
  </head>
  <body><a href={to}>Открыть кейс</a></body>
</html>
