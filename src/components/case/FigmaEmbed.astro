---
/** Встраивание прототипа или файла Figma. url — обычная ссылка figma.com/proto/... или /design/... */
interface Props {
  url: string;
  title: string;
  ratio?: string;
}
const { url, title, ratio = '16 / 10' } = Astro.props;
const src = `https://www.figma.com/embed?embed_host=share&url=${encodeURIComponent(url)}`;
---

<figure class="not-prose">
  <div class="overflow-hidden rounded-2xl border border-line bg-surface-2" style={`aspect-ratio: ${ratio}`}>
    <iframe src={src} title={title} loading="lazy" allowfullscreen class="size-full border-0"></iframe>
  </div>
  <figcaption class="mt-3 text-[14px] text-muted">
    {title} · <a class="link" href={url} target="_blank" rel="noopener">Открыть в Figma</a>
  </figcaption>
</figure>
