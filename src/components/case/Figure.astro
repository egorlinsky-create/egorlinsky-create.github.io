---
import fs from 'node:fs';
import path from 'node:path';
import { withBase } from '@/lib/utils';

interface Props {
  src: string;
  alt?: string;
  /** Подпись; **жирный** в начале — вывод */
  caption?: string;
  /** wide — шире колонки текста на десктопе */
  wide?: boolean;
}

const { src, alt, caption, wide = false } = Astro.props;
const isRemote = /^https?:\/\//.test(src);
const exists = isRemote || fs.existsSync(path.join(process.cwd(), 'public', src));
const fileName = src.split('/').pop();

const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const captionHtml = caption ? escape(caption).replace(/\*\*(.+?)\*\*/g, '<strong class="font-semibold text-text">$1</strong>') : '';
const altText = alt ?? (caption ? caption.replace(/\*\*/g, '') : '');
---

<figure class:list={['reveal not-prose', wide && 'lg:-mx-10']}>
  {
    exists ? (
      <img
        src={withBase(src)}
        alt={altText}
        loading="lazy"
        decoding="async"
        class="w-full rounded-2xl border border-line bg-surface-2"
      />
    ) : (
      <div
        class="flex aspect-[16/9] w-full flex-col items-center justify-center gap-1 rounded-2xl border border-dashed border-line bg-surface-2 p-6 text-center"
        role="img"
        aria-label={altText}
      >
        <span class="text-sm font-medium text-muted">Изображение ещё не загружено</span>
        <code class="font-mono text-xs text-muted">public{src}</code>
      </div>
    )
  }
  {captionHtml && <figcaption class="mt-3 text-[14px] leading-snug text-muted" set:html={captionHtml} />}
  {!exists && <span class="sr-only">Файл {fileName} ожидается в папке public.</span>}
</figure>
